{
  // Parameters file template for infra/main.bicep.
  //
  // Copy to infra/parameters.<tenant>.jsonc (ignored by git) and fill in the
  // values for your environment. Convert to strict JSON (remove comments) when
  // deploying — `az deployment group create --parameters @file.json` does not
  // support JSONC. Deploy with:
  //
  //   az deployment group create \
  //     --resource-group <your-rg> \
  //     --template-file infra/main.bicep \
  //     --parameters @infra/parameters.<tenant>.json \
  //     --parameters containerImage=ghcr.io/okapi-ca/ms-365-admin-mcp-server:0.5.1 \
  //     --parameters kvAdminObjectIds="['<operator-oid>']"
  //
  // Any value left as "<...>" below is a placeholder you must replace.
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "baseName": { "value": "<3-20 chars, lowercase, used as prefix for default resource names>" },
    "tags": {
      "value": {
        "Environment": "PROD",
        "DeploymentType": "Bicep",
        "AppMapping": "<your org app mapping / cost center>"
      }
    },

    // --- OAuth + auth gating (SEC-F01, SEC-F02) ---
    "oauthMode": { "value": true },
    "publicUrl": { "value": "<https://<your-mcp-fqdn>>" },
    "authorizedUsers": {
      "value": "<comma-separated Entra user OIDs authorized to authenticate>"
    },
    "allowedClients": {
      "value": "<comma-separated Entra app IDs for machine-to-machine access, or empty>"
    },
    "acrLoginServer": { "value": "" },

    // --- VNet integration (set vnetIntegrated=true to deploy an internal CAE) ---
    // Requires a pre-existing subnet delegated to Microsoft.App/environments.
    // When true: CAE runs workload-profiles + internal ingress (clients must reach
    // the VNet via VPN, ExpressRoute, or VNet peering). No public ingress, no PE.
    "vnetIntegrated": { "value": false },
    "hubSubscriptionId": { "value": "<subscription id hosting the hub VNet>" },
    "hubVnetRg": { "value": "<resource group of the hub VNet>" },
    "hubVnetName": { "value": "<hub VNet name>" },
    "infrastructureSubnetName": {
      "value": "<subnet delegated to Microsoft.App/environments, pre-created by network team>"
    },

    // --- Resource name overrides (optional) ---
    // Leave empty to derive from baseName. Override when your org has strict
    // naming conventions (e.g. Azure CAF, internal rules).
    "containerAppEnvName": { "value": "" },
    "containerAppName": { "value": "" },
    "uamiName": { "value": "" },
    "keyVaultName": { "value": "" },
    "storageAccountName": { "value": "" },
    "logAnalyticsWorkspaceName": { "value": "" },
    "appInsightsName": { "value": "" }
  }
}
